# Backend Environment Configuration Example
# Copy this file to .env for local dev.
# On Render, set these as Environment Variables in the dashboard.

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRE_MINUTES=10080

# ── Runtime ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — ephemeral on Render free tier, resets on each deploy):
# DATABASE_URL=sqlite+aiosqlite:///./signal.db
# PostgreSQL (recommended for persistent data on Render):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Replace with your actual Vercel frontend URL:
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=none
